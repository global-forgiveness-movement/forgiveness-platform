rules_version = '2';

/* Firestore security rules for the GFM platform.

   NOT deployed by anything in this repo — GitHub Pages serves static files
   only. Paste these into the Firebase console (Firestore → Rules) when the
   project is created, or deploy with `firebase deploy --only firestore:rules`.

   The shape follows what js/store.js actually reads and writes. Every
   collection the site touches is listed; anything not listed is denied by the
   final catch-all, which is the behaviour we want — a new collection should
   fail loudly rather than inherit someone else's permissions.

   Two privacy rules drive most of this:
   - The two public forms — contact messages and group registrations — collect
     names and email addresses. Both are write-only from the public: anyone may
     submit one, nobody may read them back except an editor.
   - A person's workbook progress and group membership belong to them alone.
     Nothing in here lets one signed-in user read another's.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /* Editors are seeded by hand in the console: settings/editors with an
       `emails` array. Kept out of client write reach entirely. */
    function isEditor() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email in get(/databases/$(database)/documents/settings/editors).data.emails;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /* ---- published content: the world reads, editors write ---- */
    match /content/{doc} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /pages/{page} {
      allow read: if true;
      allow write: if isEditor();
    }

    /* Edit history can name editors and hold superseded copy — editors only. */
    match /contentHistory/{entry} {
      allow read, write: if isEditor();
    }

    /* ---- anonymous download counting ---- */
    /* A counter document per edition+language. Anyone may push it up by one;
       nobody may set it to an arbitrary number, and it can never be deleted. */
    match /downloads/{tag} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    /* ---- contact messages: write-only from the public ---- */
    /* The contact page carries no email address at all; it writes here instead,
       and /admin is the only way to read it. Same shape as groups below: anyone
       may send one, only an editor may look. */
    match /contact/{entry} {
      allow create: if true;
      allow read, update, delete: if isEditor();
    }

    /* ---- group registrations: write-only from the public ---- */
    /* These hold a leader's name and email. Submitting one is open; reading
       them back is not. */
    match /groups/{entry} {
      allow create: if true;
      allow read, update, delete: if isEditor();
    }

    /* ---- group codes: readable so a member can resolve one ---- */
    /* Holds no personal data — the series, the group's location label, and
       the facilitator's account id (a random string: no name, no email).
       Immutable once written, so a code cannot be repointed at another series
       or handed to another facilitator. Whoever creates it may name only
       themselves as its facilitator. */
    match /groupCodes/{code} {
      allow read: if true;
      allow create: if !('facilitator' in request.resource.data)
                    || (signedIn() && request.resource.data.facilitator == request.auth.uid);
      allow update, delete: if isEditor();
    }

    /* The account that created this group code. Codes made before 28 Sep
       name nobody, so nobody can write their group state — safe by default. */
    function facilitates(code) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupCodes/$(code))
        && get(/databases/$(database)/documents/groupCodes/$(code)).data.get('facilitator', '') == request.auth.uid;
    }

    /* Someone who entered this code on My Path. The code is the key: anyone
       a facilitator gives it to can join, exactly as in person. */
    function inGroup(code) {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('code', '') == code;
    }

    /* ---- a running group's shared state (js/group-engine.js) ---- */
    /* Which steps the facilitator has ticked, and each meeting's date, time,
       place and link. Everyone in the group reads it; only its facilitator
       writes it. Nothing personal about any member lives here. */
    match /groupState/{code} {
      allow read: if facilitates(code) || inGroup(code) || isEditor();
      allow create, update: if facilitates(code)
                            && request.resource.data.keys().hasOnly(['steps', 'updatedAt']);
      allow delete: if facilitates(code) || isEditor();
    }

    /* ---- one person's lesson ticks ---- */
    /* Theirs alone (ruling 5). The facilitator cannot read them — the
       privacy line on My Path says entering a code "does not tell your
       facilitator ... anything about your workbook", and this keeps it true.
       If Kate and Richard rule that a facilitator may see ticks, flip
       FACILITATOR_SEES_MEMBER_TICKS in js/group-engine.js, change that
       sentence on My Path, AND add this line — all three together:
         allow read: if facilitates(resource.data.code);            */
    match /memberTicks/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['code', 'ticks', 'updatedAt']);
    }

    /* ---- a person's own records ---- */
    /* Progress is position and completion only. What anyone writes in the
       workbook never reaches Firestore at all — see js/progress-sync.js,
       which does not read the answers field. */
    match /progress/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /members/{uid} {
      allow read, write: if isOwner(uid);
    }

    /* ---- settings ---- */
    /* Readable by signed-in users because isEditor() has to check it.
       Never writable from a client: seed and edit it in the console. */
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* Anything not named above. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
